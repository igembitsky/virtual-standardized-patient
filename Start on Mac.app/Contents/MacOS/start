#!/bin/sh
# Virtual Standardized Patient Simulator, macOS launcher.
# Double-click "Start on Mac". No Terminal window opens. It:
#   1. Opens Ollama in the background if it is not running.
#   2. Starts app/server.pl with the Perl that macOS ships, which opens the browser.
# The simulator stops by itself when you close its browser tab, or press Quit in the page.
# Everything it says goes to a log: first in ~/Library/Logs, which is always allowed, and from
# the moment the folder is usable, in log.txt beside the Start files, where anyone can find it.
LOG="$HOME/Library/Logs/virtual-standardized-patient.log"
/bin/mkdir -p "$HOME/Library/Logs" 2>/dev/null || LOG="${TMPDIR:-/tmp}/virtual-standardized-patient.log"
exec >>"$LOG" 2>&1
first=$(($(/usr/bin/wc -l < "$LOG") + 1))    # this run's first line, to copy into log.txt later
echo "$(date '+%Y-%m-%d %H:%M:%S') Start on Mac: $0"

# Something went wrong before the server could start. Say so, and offer to send a report.
problem() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') PROBLEM: $1"
  report="Virtual Standardized Patient Simulator: problem report
When: $(date)
Computer: macOS $(sw_vers -productVersion 2>/dev/null), $(uname -m)
App: $0
What happened: $1
Log file: $LOG

--- launcher log, last lines ---
$(tail -n 40 "$LOG")"
  choice=$(/usr/bin/osascript -e "button returned of (display dialog \"Something went wrong.

$1

The log is in $LOG\" with title \"Virtual Standardized Patient\" buttons {\"Close\", \"Report on GitHub\", \"Email report\"} default button 3 with icon caution)")
  enc() { /usr/bin/perl -pe 's/([^A-Za-z0-9_.~-])/sprintf("%%%02X", ord $1)/ge'; }
  title=$(printf 'Problem report: %s' "$1" | head -c 80 | enc)
  case "$choice" in
    "Email report")     /usr/bin/open "mailto:?subject=$title&body=$(printf '%s' "$report" | head -c 1500 | enc)" ;;
    "Report on GitHub") /usr/bin/open "https://github.com/igembitsky/virtual-standardized-patient/issues/new?title=$title&body=$(printf '%s' "$report" | head -c 5000 | enc)" ;;
  esac
  exit 1
}

bundle="$(cd "$(dirname "$0")/../.." && pwd -P)"

# macOS runs an app it has just downloaded from a read-only copy in a hidden folder
# ("App Translocation"), which cannot see the files beside it. Find the real app.
home="$(dirname "$bundle")"
case "$bundle" in
  */AppTranslocation/*)
    echo "Running from a translocated copy: $bundle"
    # 1. The mount table. macOS mounts the real app, or its folder, on a folder above the copy:
    #    "/Users/x/Desktop/folder/Start on Mac.app on /private/var/.../AppTranslocation/<id> (nullfs, ...)"
    #    The mount point can be the copy itself, its folder, or the <id> folder above that.
    real=$(/sbin/mount | /usr/bin/awk -v b="$bundle" '
      / \(nullfs,/ {
        # The app name itself contains " on ", so split at the first " on /" that is followed by
        # the translocation folder.
        j = index($0, " (nullfs,"); head = substr($0, 1, j - 1); i = 0
        for (k = 1; k <= length(head) - 4; k++)
          if (substr(head, k, 5) == " on /" && index(substr(head, k + 4), "/AppTranslocation/")) { i = k; break }
        if (!i) next
        src = substr(head, 1, i - 1); mp = substr(head, i + 4)
        nx = substr(b, length(mp) + 1, 1)
        if (mp ~ /AppTranslocation/ && index(b, mp) == 1 && (nx == "/" || nx == "")) {
          print (src ~ /\.app$/ ? src : src "/Start on Mac.app"); exit
        }
      }')
    # 2. Spotlight, if the mount table did not say, and only if exactly one copy exists:
    #    with two copies (Downloads and Desktop) a guess could start the wrong one.
    if [ -z "$real" ]; then
      found=$(/usr/bin/mdfind -name "Start on Mac.app" 2>/dev/null | /usr/bin/grep -v /AppTranslocation/)
      [ "$(printf '%s\n' "$found" | /usr/bin/grep -c .)" = "1" ] && real="$found"
    fi
    [ -n "$real" ] || problem "macOS opened a hidden copy of Start on Mac and did not say where the real one is. Move the simulator folder into your Applications folder, then open Start on Mac from there."
    echo "The real app is $real"
    home="$(dirname "$real")" ;;
esac

# macOS protects the Desktop, Documents, Downloads and iCloud Drive folders: a program must ask
# for permission to read them. The simulator never asks. It runs from Applications, or any other
# folder, and in a protected folder it touches nothing and shows where to move it.
case "$home/" in
  "$HOME/Desktop/"*|"$HOME/Documents/"*|"$HOME/Downloads/"*|"$HOME/Library/Mobile Documents/"*)
    echo "In a protected folder: $home"
    /usr/bin/open -R "$home"
    problem "Please move the simulator folder into your Applications folder. macOS protects the Desktop, Documents and Downloads folders, and the simulator does not ask to use them. In the Finder window that just opened, drag the folder $(basename "$home") onto Applications in the sidebar. Then open it there and double-click Start on Mac." ;;
esac

# Clear the download mark on the folder, so macOS runs the real app from now on.
/usr/bin/xattr -dr com.apple.quarantine "$home" 2>/dev/null

cd "$home/app" 2>/dev/null && /bin/cat server.pl >/dev/null 2>&1 || \
  problem "The app folder could not be opened. Keep Start on Mac next to the app folder, and keep them both in the simulator folder."

# From here on, the log is log.txt in the folder, if the folder can be written.
if ( : >> "$home/log.txt" ) 2>/dev/null; then
  /usr/bin/tail -n +"$first" "$LOG" >> "$home/log.txt"
  LOG="$home/log.txt"
  exec >>"$LOG" 2>&1
fi

# Ollama: open it in the background if it is not running. The page reports anything else.
/usr/bin/curl -s -m 2 http://127.0.0.1:11434/api/tags >/dev/null || /usr/bin/open -g -a Ollama

exec /usr/bin/perl server.pl
